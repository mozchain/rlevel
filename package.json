{
  "name": "rlevel",
  "version": "1.0.0",
  "description": "Rlevel Carpentry Solutions static website",
  "private": true,
  "scripts": {
    "dev": "python3 -m http.server 3000",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "check": "npm run build:css && python3 scripts/check-site.py",
    "deploy:preview": "npm run build:css && npx --yes wrangler pages deploy . --project-name=rlevel --branch=preview --env-file .env",
    "deploy:prod": "npm run build:css && npx --yes wrangler pages deploy . --project-name=rlevel --branch=main --env-file .env"
  },
  "keywords": [
    "carpentry",
    "fire-doors",
    "commercial-carpentry",
    "cloudflare-pages"
  ],
  "author": "Mark Mosbauer",
  "license": "UNLICENSED",
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
